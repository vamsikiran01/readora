# Django Environment Variables Example
SECRET_KEY=your-production-secret-key-here
DEBUG=True
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Optional: PostgreSQL Database URL (e.g. from Supabase or Neon.tech)
# Leave commented out to use local SQLite:
# DATABASE_URL=postgresql://user:password@ep-host.aws.neon.tech/neondb?sslmode=require
